rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /hpl/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /hpl/{doc}/matches/{matchId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /hpl/{doc}/players/{playerId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
